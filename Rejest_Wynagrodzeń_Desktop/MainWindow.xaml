<Window x:Class="Rejest_Wynagrodzeń_Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulator i Rejestr Wynagrodzeń"
        Height="620" Width="950"
        Background="#E9EEF4">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#303846" CornerRadius="5">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Kalkulator Wynagrodzeń - Autor: 00000000000"
                           Foreground="White"
                           FontSize="15"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F5F7FA"
                    BorderBrush="#B8C3D0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15">

                <StackPanel>
                    <TextBlock Text="Dane Wejściowe"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Wynagrodzenie brutto w PLN"/>

                    <TextBox x:Name="TxtBrutto"
                             Text="5000,00"
                             FontSize="16"
                             Padding="8"
                             Margin="0,5,0,20"/>

                    <TextBlock Text="Rodzaj Umowy"
                               FontWeight="Bold"/>

                    <RadioButton x:Name="RbPraca"
                                 Content="Umowa o pracę"
                                 IsChecked="True"
                                 Margin="5,10"/>

                    <RadioButton x:Name="RbZlecenie"
                                 Content="Umowa zlecenie"
                                 Margin="5"/>

                    <CheckBox x:Name="ChkUlga"
                              Content="Ulga dla młodych do 26 lat"
                              Margin="0,20,0,30"/>

                    <Button Content="OBLICZ I ZAPISZ"
                            Name="BtnOblicz"
                            Click="BtnOblicz_Click"
                            Background="#2874C8"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Padding="12"
                            Height="55"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#F5F7FA"
                    BorderBrush="#B8C3D0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Margin="12,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Wyniki i Historia"
                               FontSize="17"
                               FontWeight="Bold"/>

                    <StackPanel Grid.Row="1" Margin="0,15,0,10">
                        <TextBlock x:Name="TxtNetto"
                                   Text="Wynagrodzenie netto: 0,00 PLN"
                                   Foreground="Green"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Szczegóły Składek i Podatków"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="TxtZUS"
                                   Text="Składki ZUS (społeczne): 0,00 PLN"
                                   Margin="5"/>

                        <TextBlock x:Name="TxtZdrowotna"
                                   Text="Składka zdrowotna: 0,00 PLN"
                                   Margin="5"/>

                        <TextBlock x:Name="TxtPIT"
                                   Text="Zaliczka na podatek PIT: 0,00 PLN"
                                   Margin="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Rejestr Wynagrodzeń"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,5,0,8"/>

                        <DataGrid x:Name="DgHistoria"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data"
                                    Binding="{Binding Data}" Width="*"/>

                                <DataGridTextColumn Header="Kwota Brutto"
                                    Binding="{Binding Brutto}" Width="*"/>

                                <DataGridTextColumn Header="Umowa"
                                    Binding="{Binding Umowa}" Width="*"/>

                                <DataGridTextColumn Header="Netto"
                                    Binding="{Binding Netto}" Width="*"/>

                                <DataGridTextColumn Header="Ulga"
                                    Binding="{Binding Ulga}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
